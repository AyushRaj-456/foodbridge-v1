# =============================================================================
# FoodBridge Client Environment Variables Template
# Copy this file to .env.local for local development.
# STRICT SECURITY RULE: Never commit real API keys, production tokens, or secrets.
# =============================================================================

# Local Development Emulators (Set 'true' to run 100% offline at zero cost)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_AUTH_PORT=9099
VITE_FIREBASE_FIRESTORE_PORT=8080
VITE_FIREBASE_STORAGE_PORT=9199

# Firebase Web App Credentials (Firebase Spark Plan - 100% Free)
# Find these in Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=1:YOUR_MESSAGING_SENDER_ID:web:YOUR_APP_HASH

# Firebase Cloud Messaging (Web Push)
# Generate key pair in Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=YOUR_PUBLIC_VAPID_KEY_BASE64

# Firebase App Check (Recommended for production abuse prevention)
# Register reCAPTCHA v3 key in Firebase Console -> App Check
VITE_FIREBASE_APPCHECK_RECAPTCHA_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# Zero-Cost Geocoding & Mapping Service
# Default: OpenStreetMap Nominatim / Photon API (Zero-cost, no paid API keys required)
# Comply with OSM Acceptable Use Policy (< 1 req/sec, valid User-Agent header)
VITE_GEOCODING_API_URL=https://photon.komoot.io/api

# Voluntary Community Support UPI ID (Admin Configurable)
# Leave empty until community UPI channel is officially configured
VITE_CONTRIBUTION_UPI_ID=
