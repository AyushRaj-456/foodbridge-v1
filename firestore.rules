rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isVerifiedRecipient() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/recipients/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/recipients/$(request.auth.uid)).data.verificationStatus == 'verified' &&
        get(/databases/$(database)/documents/recipients/$(request.auth.uid)).data.get('suspended', false) == false;
    }

    function isVerifiedCourier() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.verificationStatus == 'verified' &&
        get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.get('suspended', false) == false;
    }

    function validSelfRoles(roles) {
      // Users can only assign operational roles to themselves, NEVER admin
      return roles is list &&
             !('admin' in roles) &&
             roles.hasOnly(['donor', 'recipient', 'delivery']);
    }

    // 1. User Profiles & Roles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // On creation: cannot set admin status or admin role
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.get('isAdmin', false) == false &&
        validSelfRoles(request.resource.data.get('roles', []));

      // On update: cannot self-elevate to admin or change admin flag
      allow update: if isOwner(userId) &&
        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
        validSelfRoles(request.resource.data.get('roles', [])) ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // 2. Recipient Organizations
    match /recipients/{recipientId} {
      // Readable by owner, admins, or authenticated users verifying operational status in matching
      allow read: if isOwner(recipientId) || isAdmin() || isAuthenticated();

      // On creation: verification status must be strictly 'pending' and not suspended
      allow create: if isOwner(recipientId) &&
        request.resource.data.userId == recipientId &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.get('suspended', false) == false;

      // On update by owner: cannot change verificationStatus, admin notes, or suspension
      allow update: if isOwner(recipientId) &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
        request.resource.data.get('verifiedAt', null) == resource.data.get('verifiedAt', null) &&
        request.resource.data.get('verifiedBy', null) == resource.data.get('verifiedBy', null) &&
        request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null) ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // 3. Delivery Partners
    match /deliveryPartners/{partnerId} {
      allow read: if isOwner(partnerId) || isAdmin() || isAuthenticated();

      // On creation: verification status must be strictly 'pending' and not suspended
      allow create: if isOwner(partnerId) &&
        request.resource.data.userId == partnerId &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.get('suspended', false) == false;

      // On update: cannot modify verification status or suspension unless admin
      allow update: if isAuthenticated() && (
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
        request.resource.data.get('verifiedAt', null) == resource.data.get('verifiedAt', null) &&
        request.resource.data.get('verifiedBy', null) == resource.data.get('verifiedBy', null) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 4. Donors
    match /donors/{donorId} {
      allow read: if isOwner(donorId) || isAdmin() || isAuthenticated();
      allow create, update: if isOwner(donorId) && request.resource.data.userId == donorId;
      allow delete: if isAdmin();
    }

    // 5. Food Surplus Listings
    match /listings/{listingId} {
      allow read: if isAuthenticated();

      // Creation: must be authenticated donor, starting with 'matching' status
      allow create: if isAuthenticated() &&
        request.resource.data.donorId == request.auth.uid &&
        request.resource.data.status == 'matching' &&
        request.resource.data.get('acceptedRecipientId', null) == null;

      // Update:
      // - Donor can manage and update their listing
      // - Verified recipient can accept matching donation, decline, or coordinate delivery / confirm receipt
      // - Assigned courier can update transit status
      // - Admins can update any field
      allow update: if isAuthenticated() && (
        // 1. Donor updates
        isOwner(resource.data.donorId) ||
        // 2. Recipient accepting, declining, or managing accepted donation
        (
          resource.data.status == 'matching' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedRecipientId == request.auth.uid
        ) ||
        (
          resource.data.status == 'matching' &&
          request.auth.uid in request.resource.data.get('declinedRecipientIds', [])
        ) ||
        (
          resource.data.acceptedRecipientId == request.auth.uid
        ) ||
        // 3. Assigned Delivery Partner updating delivery / transit status
        (
          request.resource.data.get('deliveryPartnerId', null) == request.auth.uid ||
          resource.data.get('deliveryPartnerId', null) == request.auth.uid
        ) ||
        // 4. Admin override
        isAdmin()
      );

      allow delete: if isOwner(resource.data.donorId) || isAdmin();
    }

    // 6. Delivery Requests & Coordination
    match /deliveries/{deliveryId} {
      // Open requests are readable by verified delivery partners; assigned requests are private to participants
      allow read: if isAuthenticated() && (
        resource.data.status == 'requested' ||
        resource.data.assignedPartnerId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      // Creation allowed by donor or recipient linked to the listing
      allow create: if isAuthenticated() && (
        request.resource.data.donorId == request.auth.uid ||
        request.resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      // Updates allowed by assigned participants, couriers claiming open requests, or admins
      allow update: if isAuthenticated() && (
        resource.data.assignedPartnerId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        (resource.data.status == 'requested' && request.resource.data.status == 'assigned') ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 7. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // 8. Audit Logs (Immutable append-only records)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Only authenticated admins can write audit records
      allow create: if isAdmin() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.timestamp != null;
      allow update, delete: if false; // Append-only audit trail
    }

    // 9. Conversations & In-App Real-time Chat
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 10. Support Memberships
    match /memberships/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 11. Support Contribution Transactions (Immutable)
    match /supportTransactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 12. User Wallets
    match /wallets/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 13. Reward Ledger (Plan-Based Batches)
    match /rewardLedger/{batchId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // 14. Token Redemption Requests
    match /redemptionRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 15. Daily Platform & Pair Limits
    match /dailyRewardCounters/{dateIST} {
      allow read, write: if isAuthenticated();
    }

    match /dailyPairRewardCounters/{pairKey} {
      allow read, write: if isAuthenticated();
    }
  }
}
